_add_minos_repository() {
    _printfl "Adding repositories"
    _minos_archive_key > /tmp/minos-archive.asc
    _add_repository "deb http://ppa.launchpad.net/minos-archive/main/ubuntu ${1} main" /tmp/minos-archive.asc
    _cmd rm -f /tmp/minos-archive.asc
    _add_repository "deb http://archive.ubuntu.com/ubuntu/ ${1} multiverse"
    _add_repository "deb http://archive.ubuntu.com/ubuntu/ ${1}-updates multiverse"
    _apt_update 0
}

_install_debootstrap() {
    _idebootstrap__tmpdir="/tmp/debootstrap_$$"
    _cmd_verbose mkdir -p "${_idebootstrap__tmpdir}"

    (
        _cmd_verbose cd "${_idebootstrap__tmpdir}"
        #https://packages.ubuntu.com/resolute/debootstrap, the one that knows every release at _releases
        _cmd_verbose wget -q http://mirrors.kernel.org/ubuntu/pool/main/d/debootstrap/debootstrap_1.0.142ubuntu1_all.deb
        _cmd_verbose busybox ar -x debootstrap_1.0.142ubuntu1_all.deb
        _cmd_verbose cd /
        _cmd_verbose tar zxf "${_idebootstrap__tmpdir}/data.tar.gz"
    )

    _cmd_verbose command -v "debootstrap"
    _cmd_verbose rm -rf "${_idebootstrap__tmpdir}"
}

_umount_tree() { #unmount $1 and everything mounted below it, the deepest first
    [ -z "${1}" ] && return 1
    awk -v top="${1}" '$2 == top || index($2, top "/") == 1 {print $2}' /proc/mounts | LC_ALL=C sort -r | \
        while read -r _utree__point; do
            umount "${_utree__point}" 2>/dev/null || umount -l "${_utree__point}"
        done
}

_disk_of_partition() { #a partition => the disk it is on, as sysfs knows it: /dev/sda2 => /dev/sda, /dev/nvme0n1p2 => /dev/nvme0n1
    _dopartition__name="$(readlink -f "${1}")"; _dopartition__name="${_dopartition__name##*/}"
    [ -f "/sys/class/block/${_dopartition__name}/partition" ] || return 1
    _dopartition__disk="$(dirname "$(readlink -f "/sys/class/block/${_dopartition__name}")")"
    _dopartition__disk="/dev/${_dopartition__disk##*/}"
    [ -b "${_dopartition__disk}" ] || return 1
    printf "%s\\n" "${_dopartition__disk}"
}

_disk_id() { #a disk => its /dev/disk/by-id name, which stays this disk when another one takes its /dev name
    for _did__link in /dev/disk/by-id/*; do
        [ -L "${_did__link}" ] || continue
        if [ X"$(readlink -f "${_did__link}")" = X"$(readlink -f "${1}")" ]; then
            printf "%s\\n" "${_did__link}"
            return 0
        fi
    done
    printf "%s\\n" "${1}"
}

_blkid_tag() { #$1 device, $2 tag (UUID, TYPE) => its value; blkid of util-linux or of busybox
    blkid "${1}" 2>/dev/null | sed -n "s/.* ${2}=\"\\([^\"]*\\)\".*/\\1/p"
}

_find_esp() { #a disk => its EFI system partition (GPT type c12a7328-..., MBR type ef), when it has one
    command -v lsblk >/dev/null 2>&1 || return 1
    lsblk -lnpo NAME,PARTTYPE "${1}" 2>/dev/null | awk '
        tolower($2) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" || tolower($2) == "0xef" {print $1; exit}'
}

_copy_running_setup() { #$1 file: this very script, for the step that runs inside the chroot
    if [ -f "${0}" ] && grep "^VERSION=\"${VERSION}\"" "${0}" >/dev/null 2>&1; then
        _cmd_verbose cp "${0}" "${1}"
    else
        #read from a pipe (wget -qO- minos.io/s | sudo sh -s), what ran cannot be read again
        _printfs "this script came through a pipe, fetching it again for the step inside ..."
        _cmd_verbose wget -qO "${1}" minos.io/s
    fi
}

_is_minos_live() { #is this the live session of the minos ISO? casper's read-only system mounted on /rofs,
    #the ISO's list of what only its live session needs in it, and the boot loaders' packages on the medium
    awk '$2 == "/rofs" {found = 1} END {exit !found}' /proc/mounts && [ -f /rofs/var/lib/minos/live-only ] && \
        [ -f /cdrom/minos/bootloader/bios.list ] && [ -f /cdrom/minos/bootloader/uefi.list ]
}

_copy_live_system() { #$1 target: the minos ISO's system copied to it as it was built (casper's /rofs, not the
    #session's changes over it), less what only the live session needs: each path the ISO lists in
    #/var/lib/minos/live-only gets back the copy kept in live-only.d, or goes when there is none (a file the
    #live session added). The boot loaders' packages of the medium go to the target's /tmp
    _clsystem__target="${1}"
    _printfs "copying the live system, $(($(cat /cdrom/casper/filesystem.size 2>/dev/null || printf 0) / 1048576)) MiB ..."
    _cmd_verbose cp -a /rofs/. "${_clsystem__target}/"
    while read -r _clsystem__path; do
        [ -n "${_clsystem__path}" ] || continue
        if [ -e "/rofs/var/lib/minos/live-only.d${_clsystem__path}" ] || \
           [ -L "/rofs/var/lib/minos/live-only.d${_clsystem__path}" ]; then
            _cmd_verbose rm -f "${_clsystem__target}${_clsystem__path}"
            _cmd_verbose cp -a "/rofs/var/lib/minos/live-only.d${_clsystem__path}" "${_clsystem__target}${_clsystem__path}"
        else
            _cmd_verbose rm -f "${_clsystem__target}${_clsystem__path}"
        fi
    done < /rofs/var/lib/minos/live-only
    _cmd_verbose rm -rf "${_clsystem__target}/var/lib/minos/live-only" "${_clsystem__target}/var/lib/minos/live-only.d"
    _cmd_verbose cp -a /cdrom/minos/bootloader "${_clsystem__target}/tmp/minos-bootloader"
}

################################################################################
# Deployment functions #########################################################
################################################################################

_core() {
    if [ -n "$(_get_release)" ]; then
        _backup_original_reps
        _add_minos_repository "$(_get_release)"
    else
        _die "Couldn't find valid release"
    fi

    _printfs "Installing packages ..."
    #_cmd_animate apt-get install --no-install-recommends -y minos-core
    _cmd_verbose apt-get install --no-install-recommends -y --force-yes minos-core
    _recover_original_reps

    _printfs "Removing leftovers  ..."
    _cmd_animate apt-get purge -y squid-deb-proxy-client apt-cacher-ng
    _cmd_animate apt-get autoremove

    _printfl "DONE"
    printf "\\n%s\\n" "Reload your session or relogin to get started, have fun! n@n/"
    printf "%s\\n"    "    $ source ~/.bashrc"
}

_desktop() {
    if [ -n "$(_get_release)" ]; then
        _backup_original_reps
        _add_minos_repository "$(_get_release)"
    else
        _die "Couldn't find valid release"
    fi

    _printfs "Installing packages ..."
    #_cmd_animate DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y minos-desktop
    _cmd_verbose export DEBIAN_FRONTEND=noninteractive
    _cmd_verbose apt-get install --no-install-recommends -y --force-yes minos-desktop
    #[ -d "${HOME}"/.gvfs ] && fusermount -u "${HOME}"/.gvfs
    _recover_original_reps
    #connman manages the network from now on: the wired cards leave networkd, which live mode gave them on a core
    if [ -f /etc/netplan/01-minos-wired.yaml ]; then
        _cmd rm -f /etc/netplan/01-minos-wired.yaml
    fi

    _printfl "DONE"
    printf   "\\n%s\\n" "Restart your computer to get started, have fun!, n@n/"
}

_live() {
    _live__release="$(_get_release)"
    _live__rnumber="$(_get_release_number "${_live__release}")"
    _live__arch="$(_get_arch)"
    _live__root_partition="${root_partition}"
    _live__home_partition="${home_partition}"
    _live__esp_partition="${esp_partition}"
    _live__username="${username}"
    _live__passwd="${passwd}"
    _live__tmp_mnt="/minos"
    #wicd left ubuntu at focal, and since then the initramfs has to be generated by hand
    _live__since_focal=""
    _release_at_least "${_live__release}" "20.04" && _live__since_focal="yes"
    _live__swap="$(blkid|awk '/swap/&&/PART/{print $1;exit;}'|sed 's/://g')"
    _live__secs="10"

    #grub goes to the disk of /, named the way sysfs names it (/dev/nvme0n1p2 is on /dev/nvme0n1)
    _live__disk="$(_disk_of_partition "${_live__root_partition}")" || \
        _die "${_live__root_partition} is not a partition of a disk, grub would have nowhere to go"

    #fstab names file systems by UUID: /dev/sdX changes when another disk is plugged in
    _live__root_uuid="$(_blkid_tag "${_live__root_partition}" UUID)"
    [ -n "${_live__root_uuid}" ] || _die "${_live__root_partition} has no file system, format it first: mkfs.ext4 ${_live__root_partition}"
    _live__home_uuid=""
    if [ -n "${_live__home_partition}" ]; then
        _live__home_uuid="$(_blkid_tag "${_live__home_partition}" UUID)"
        [ -n "${_live__home_uuid}" ] || _die "${_live__home_partition} has no file system, format it first: mkfs.ext4 ${_live__home_partition}"
    fi
    _live__swap_uuid=""
    [ -n "${_live__swap}" ] && _live__swap_uuid="$(_blkid_tag "${_live__swap}" UUID)"

    #the installed system boots the way this live session booted
    _live__esp_uuid=""
    if [ -d /sys/firmware/efi ]; then
        _live__firmware="UEFI"
        [ X"${_live__arch}" = X"amd64" ] || _die "UEFI installs are amd64 only, this is ${_live__arch}"
        [ -z "${_live__esp_partition}" ] && _live__esp_partition="$(_find_esp "${_live__disk}")"
        [ -n "${_live__esp_partition}" ] || _die "UEFI boots from an EFI system partition and ${_live__disk} has none:" \
            "create one (FAT32, type EFI System) or name it with --esp"
        [ X"$(_blkid_tag "${_live__esp_partition}" TYPE)" = X"vfat" ] || \
            _die "${_live__esp_partition} is not FAT, format it first: mkfs.vfat -F 32 ${_live__esp_partition}"
        _live__esp_uuid="$(_blkid_tag "${_live__esp_partition}" UUID)"
        _live__grub_packages="grub-efi-amd64 grub-efi-amd64-signed shim-signed efibootmgr"
        _live__bootloader_list="uefi.list"
        _live__disk_id=""
    else
        _live__firmware="BIOS"
        [ -z "${_live__esp_partition}" ] || _die "--esp is for UEFI, and this session booted through BIOS"
        _live__grub_packages="grub-pc grub2-common"
        _live__bootloader_list="bios.list"
        #grub-pc installs itself again on its upgrades, to the disk named here: by id, so it stays this disk
        _live__disk_id="$(_disk_id "${_live__disk}")"
    fi

    #in the live session of the minos ISO, minos-desktop of its release is already here: that system is
    #copied to the disk, with no network. Anything else (minos-core, another release) is bootstrapped from
    #the network as in any other live session, with the debootstrap and wget that session carries
    _live__copy=""
    if _is_minos_live; then
        # shellcheck disable=SC1091 # the live system's, read where it runs
        _live__minos_live="$(. /rofs/etc/os-release; printf "%s" "${VERSION_CODENAME}")"
        if [ X"${submode}" = X"desktop" ] && [ X"${_live__release}" = X"${_live__minos_live}" ]; then
            _live__copy="yes"
        fi
    fi

    printf "\033[1A" #override previous line
    _printfl "Minos Live Installer"
    printf "%b\\n" "${WHITE_BOLD}Release:     ${DEFAULT}${_live__release} / ${_live__rnumber}"
    printf "%b\\n" "${WHITE_BOLD}Arch:        ${DEFAULT}${_live__arch}"
    printf "%b\\n" "${WHITE_BOLD}Target:      ${DEFAULT}${_live__tmp_mnt}"
    if [ -n "${_live__copy}" ]; then
        printf "%b\\n" "${WHITE_BOLD}Source:      ${DEFAULT}this live system, copied (no network needed)"
    fi
    printf "\\n"
    printf "%b\\n" "${WHITE_BOLD}/ partition: ${DEFAULT}${_live__root_partition}"
    if [ -n "${_live__home_partition}" ]; then
        printf "%b\\n" "${WHITE_BOLD}/home  part: ${DEFAULT}${_live__home_partition}"
    fi
    printf "%b\\n" "${WHITE_BOLD}Firmware:    ${DEFAULT}${_live__firmware}"
    printf "%b\\n" "${WHITE_BOLD}Grub:        ${DEFAULT}${_live__disk}"
    if [ -n "${_live__esp_partition}" ]; then
        printf "%b\\n" "${WHITE_BOLD}EFI part:    ${DEFAULT}${_live__esp_partition}"
    fi
    printf "%b\\n" "${WHITE_BOLD}Swap:        ${DEFAULT}${_live__swap:-None}"
    printf "\\n"
    printf "%b\\n" "${WHITE_BOLD}Account:     ${DEFAULT}${_live__username} / $(printf "%s\\n" "${_live__passwd}"|sed 's:.:*:g')"

    _printfl
    _printf_sleep  "Press Ctrl-C to cancel, or wait X seconds to continue ..." "${_live__secs}"

    printf "\033[1A" #override previous line
    if [ -n "${_live__copy}" ]; then
        _printfl "Copying the live system"
    else
        _printfl "Bootstrapping"
        if ! command -v "debootstrap" >/dev/null 2>&1; then
            _install_debootstrap
        fi
    fi

    #whatever an earlier attempt left mounted
    _umount_tree "${_live__tmp_mnt}"
    umount "${_live__root_partition}" 2>/dev/null || :

    _cmd_verbose mkdir -p "${_live__tmp_mnt}"
    _cmd_verbose mount "${_live__root_partition}" "${_live__tmp_mnt}"

    if [ -n "${_live__copy}" ]; then
        _copy_live_system "${_live__tmp_mnt}"
    else
        _cmd_verbose debootstrap --arch "${_live__arch}" "${_live__release}" "${_live__tmp_mnt}"

        cat > "${_live__tmp_mnt}/etc/apt/sources.list" << E=O=F
deb http://archive.ubuntu.com/ubuntu/  ${_live__release} main restricted universe multiverse
deb http://security.ubuntu.com/ubuntu/ ${_live__release}-security main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu/  ${_live__release}-updates main restricted universe multiverse
E=O=F
        _cmd_verbose sed -i "/cdrom:/d" "${_live__tmp_mnt}/etc/apt/sources.list"
    fi

    if [ -n "${_live__home_partition}" ]; then
        _cmd_verbose mount "${_live__home_partition}" "${_live__tmp_mnt}/home"
    fi
    if [ -n "${_live__esp_partition}" ]; then
        _cmd_verbose mkdir -p "${_live__tmp_mnt}/boot/efi"
        _cmd_verbose mount "${_live__esp_partition}" "${_live__tmp_mnt}/boot/efi"
    fi

    _printfl "Generating new /etc/fstab file"
    printf "%s\\n" "UUID=${_live__root_uuid} / ext4 errors=remount-ro 0 1" | tee "${_live__tmp_mnt}/etc/fstab"
    if [ -n "${_live__home_uuid}" ]; then
        printf "%s\\n" "UUID=${_live__home_uuid} /home ext4 errors=remount-ro 0 1" | tee -a "${_live__tmp_mnt}/etc/fstab"
    fi
    if [ -n "${_live__esp_uuid}" ]; then
        printf "%s\\n" "UUID=${_live__esp_uuid} /boot/efi vfat umask=0077 0 1" | tee -a "${_live__tmp_mnt}/etc/fstab"
    fi
    if [ -n "${_live__swap_uuid}" ]; then
        printf "%s\\n" "UUID=${_live__swap_uuid} none swap sw 0 0" | tee -a "${_live__tmp_mnt}/etc/fstab"
    fi
    printf "%s\\n" "proc /proc proc  defaults 0 0"   | tee -a "${_live__tmp_mnt}/etc/fstab"
    printf "%s\\n" "sys  /sys  sysfs defaults 0 0"   | tee -a "${_live__tmp_mnt}/etc/fstab"

    _printfl "Chrooting into ${_live__tmp_mnt}"
    #one by one, not --rbind: unmounting a recursive copy of /sys takes the live session's own submounts with it
    for _live__dir in /dev /dev/pts /proc /sys; do #apt writes its log through /dev/pts
        _cmd_verbose mount --bind "${_live__dir}" "${_live__tmp_mnt}${_live__dir}"
    done
    if [ X"${_live__firmware}" = X"UEFI" ]; then #grub-install writes the boot entry into the NVRAM through efivarfs
        _cmd_verbose mount -t efivarfs efivarfs "${_live__tmp_mnt}/sys/firmware/efi/efivars"
    fi

    #the step inside runs this same script, not whatever minos.io/s holds by then; a copy has minos already
    [ -n "${_live__copy}" ] || _copy_running_setup "${_live__tmp_mnt}/tmp/minos-setup"
    _live_script > "${_live__tmp_mnt}/tmp/minos-live-install"
    (umask 077; printf "%s:%s\\n" "${_live__username}" "${_live__passwd}" > "${_live__tmp_mnt}/tmp/minos-live-passwd")

    #an explicit command: without one chroot opens an interactive shell
    if chroot "${_live__tmp_mnt}" /bin/sh /tmp/minos-live-install < /dev/null; then
        _cmd_verbose rm -rf "${_live__tmp_mnt}/tmp/minos-setup" "${_live__tmp_mnt}/tmp/minos-live-install" \
            "${_live__tmp_mnt}/tmp/minos-live-step" "${_live__tmp_mnt}/tmp/minos-bootloader"
        _printfl "Unmounting ${_live__tmp_mnt}"
        _umount_tree "${_live__tmp_mnt}"
        _printfl "DONE: Reboot the system to get started, have fun!, n.n/"
    else
        _live__step="$(cat "${_live__tmp_mnt}/tmp/minos-live-step" 2>/dev/null)"
        #minos-live-passwd holds the password, when the step that reads it did not get to remove it
        rm -f "${_live__tmp_mnt}/tmp/minos-live-install" "${_live__tmp_mnt}/tmp/minos-live-step" \
            "${_live__tmp_mnt}/tmp/minos-live-passwd"
        #the exit trap unmounts the target
        _die "FAILED while ${_live__step:-entering the chroot}: the command that failed is the last one above," \
            "the system is not ready to boot"
    fi

#TODO
#hostnamectl set-hostname minos
#dpkg-reconfigure keyboard-configuration
#dpkg-reconfigure tzdata
#locale-gen en_US.UTF-8
#dpkg-reconfigure locales
#dpkg-reconfigure console-data
#dpkg-reconfigure console-setup

#
}

_live_script() { #the steps live mode runs inside its target, from the _live__ variables: on a system it
    #bootstrapped, the kernel, minos and grub from the network; on a copy of the minos ISO's live system,
    #which has the kernel and minos, casper out and grub from the medium's packages, with no network
    cat << EOF
#run by minos.io/s live inside ${_live__tmp_mnt}; each step leaves its name in /tmp/minos-live-step
set -e
_step() { printf "%s\\n" "\${*}" > /tmp/minos-live-step; printf "\\n[+] %s\\n" "\${*}"; }
export DEBIAN_FRONTEND=noninteractive
set -x

EOF
    if [ -n "${_live__copy}" ]; then
        cat << EOF
_step "removing casper, the live session's boot, and what came only for it"
apt-get purge -y --autoremove casper

EOF
    else
        cat << EOF
_step "updating ${_live__release} from its -updates and -security"
apt-get update
apt-get dist-upgrade -y

_step "installing grub for ${_live__firmware}"
if [ X"${_live__firmware}" = X"BIOS" ]; then
    printf "%s\\n" "grub-pc grub-pc/install_devices multiselect ${_live__disk_id}" | debconf-set-selections
fi
apt-get install --no-install-recommends -y wget ${_live__grub_packages}

_step "installing the kernel"
#without recommends the kernel comes with nothing to build its initramfs
apt-get install --no-install-recommends -y initramfs-tools
apt-get install --no-install-recommends -y linux-generic-hwe-${_live__rnumber} || \\
    apt-get install --no-install-recommends -y linux-generic

EOF
    fi
    cat << EOF
_step "creating the user ${_live__username}"
adduser --quiet --disabled-password --shell /bin/bash --home "/home/${_live__username}" --gecos "" "${_live__username}"
#the password from a file: written into this script, its quotes, \$ and backslashes would be the shell's
chpasswd < /tmp/minos-live-passwd
rm -f /tmp/minos-live-passwd
for group in adm cdrom sudo dip plugdev netdev admin; do
    if ! grep -q "\${group}" /etc/group; then
        addgroup "\${group}"
    fi
    usermod -aG "\${group}" "${_live__username}"
done

EOF
    if [ -n "${_live__copy}" ]; then
        cat << EOF
_step "configuring minos' settings again, now that ${_live__username} exists"
#bootstrapped, minos goes in after the user, and its settings packages write into that user's home and
#name it as slim's default user; in the copy the user comes after them
dpkg-reconfigure \$(dpkg-query -W -f='\${db:Status-Abbrev} \${Package}\\n' '*minos*-settings' | awk '\$1 == "ii" {print \$2}')

EOF
    else
        cat << EOF
_step "installing minos-${submode}"
sh /tmp/minos-setup ${submode}

_step "upgrading what minos-${submode} brought, removing what nothing needs"
apt-get dist-upgrade -y
apt-get autoremove -y

_step "installing what keeps the system up to date: security updates, the next LTS"
#unattended-upgrades applies the security updates every day; ubuntu-release-upgrader-core brings
#do-release-upgrade. The minos ISO carries both, for a copy
apt-get install --no-install-recommends -y unattended-upgrades ubuntu-release-upgrader-core

EOF
    fi
    _live_slim_script
    cat << EOF
_step "giving the wired network cards an address"
#debootstrap leaves no network configuration. Ubuntu's own manager is already here (netplan, rendered by
#systemd-networkd, priority important on every release): every wired card takes DHCP, under the names the
#kernel gives (en*) or the old ones (eth*, net.ifnames=0). minos-desktop brings connman, which manages the
#network itself and must not share the cards; a copy of the minos ISO has it
if ! dpkg-query -W -f='\${Status}\\n' connman 2>/dev/null | grep -qx 'install ok installed'; then
    printf '%s\\n' '# minos.io/s live: every wired card takes an address by DHCP' 'network:' '  version: 2' \\
        '  renderer: networkd' '  ethernets:' '    wired:' '      match:' '        name: "en*"' '      dhcp4: true' \\
        '    wired-eth:' '      match:' '        name: "eth*"' '      dhcp4: true' > /etc/netplan/01-minos-wired.yaml
    chmod 600 /etc/netplan/01-minos-wired.yaml
    #enabled as Ubuntu's installer leaves it, so network-online.target waits for the addresses (its wait-online)
    systemctl enable systemd-networkd.service
fi

_step "setting the host name, keyboard, locale and time zone"
if [ ! -e /usr/bin/python ]; then
    if   [ -e /usr/bin/python3 ]; then
        ln -s /usr/bin/python3 /usr/bin/python
    elif [ -e /usr/bin/python2 ]; then
        ln -s /usr/bin/python2 /usr/bin/python
    fi
fi

sed -i -e "/^127.0.0.1/ s:^127.*:127.0.0.1\tminos minos.lan localhost:" /etc/hosts
echo 'minos' | tee /etc/hostname
hostnamectl set-hostname 'minos' || :

sed -i -e '/^XKBMODEL/  s:=.*:="pc105":' /etc/default/keyboard
sed -i -e '/^XKBLAYOUT/ s:=.*:="latam":' /etc/default/keyboard

sed -i -e '/^CHARMAP/   s:=.*:="UTF-8":' /etc/default/console-setup
sed -i -e '/^CODESET/   s:=.*:="guess":' /etc/default/console-setup

locale-gen en_US.UTF-8
update-locale LANG=en_US.UTF-8

#https://stackoverflow.com/a/42344810/890858
ln -fs /usr/share/zoneinfo/America/Mexico_City /etc/localtime
dpkg-reconfigure --frontend noninteractive tzdata

EOF
    if [ -n "${_live__copy}" ]; then
        cat << EOF
_step "installing the boot loader for ${_live__firmware}, from the medium's packages"
if [ X"${_live__firmware}" = X"BIOS" ]; then
    printf "%s\\n" "grub-pc grub-pc/install_devices multiselect ${_live__disk_id}" | debconf-set-selections
else
    #until minos-untrim brings the graphics drivers, the kernel draws through simpledrm on the display mode
    #GRUB hands it, and on UEFI a mode GRUB sets may be one the display does not show as drawn (black under
    #OVMF): GRUB stays on the firmware's console and leaves its mode alone, as the minos ISO's menu does
    mkdir -p /etc/default/grub.d
    printf "%s\\n" "#minos.io/s live, copied from the minos ISO on UEFI: the firmware's display mode, untouched" \\
        "GRUB_TERMINAL=console" > /etc/default/grub.d/minos-console.cfg
fi
cd /tmp/minos-bootloader
apt-get install --no-install-recommends -y \$(sed 's|^|./|' ${_live__bootloader_list})
cd /
#the live system has a kernel and no initramfs: it booted from casper's, on the medium
update-initramfs -c -k all
EOF
    else
        cat << EOF
_step "installing the boot loader for ${_live__firmware}"
if [ X"${_live__since_focal}" = X"yes" ]; then
    update-initramfs -u -k "\$(dpkg --list  | \\
        awk '/linux-image/{print \$2;exit}' | sed 's:linux-image-::g')"
fi
EOF
    fi
    cat << EOF
if [ X"${_live__firmware}" = X"BIOS" ]; then
    grub-install "${_live__disk}"
else
    #the signed grub looks for its config in EFI/ubuntu; Ubuntu's grub-install also copies itself to
    #EFI/BOOT/BOOTX64.EFI, for firmware that forgets its NVRAM, and keeps both on its upgrades
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ubuntu
fi
update-grub
EOF
    #the ISO leaves out the kernel modules and firmware that are neither network nor booting; the copy
    #gets them back from the network, at its first boot that has one (the ISO's minos-untrim unit)
    if [ -n "${_live__copy}" ] && [ -f /rofs/var/lib/minos/live-trimmed ]; then
        cat << EOF

_step "leaving the kernel modules and firmware the ISO left out to minos-untrim, at the first boot with a network"
systemctl enable minos-untrim.service
EOF
    fi
}

_live_slim_script() { #the step live mode runs inside its target once minos is there, bootstrapped or copied
    #from the minos ISO alike: what Ubuntu's base brings and minos does not use goes. The lists are the ones
    #minos' boxes purge (packers' autoinstall/user-data), and then four services of priority important that
    #debootstrap brings and no minos package asks for: rsyslog (the journal keeps the logs), cron (minos'
    #jobs run from systemd timers), networkd-dispatcher (networkd's hook runner) and dbus-user-session
    #(systemd's per-user bus). Each line it prints says what a list purged
    printf "%s\\n" "_step \"removing what minos-${submode} does not use\"" "minos_meta=\"minos-${submode}\""
    cat << 'EOF'
set +x #each list says on a line of its own what it purges
_installed() { #dpkg patterns => the installed packages among them
    dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' "${@}" 2>/dev/null | awk '$1 ~ /^.i/ {print $2}'
}
#what stays whatever a list says: minos and what it depends on, Ubuntu's required packages, and what boots
#the system, reaches it, lets it be administered and keeps it up to date
keep="$( { apt-cache depends --recurse --installed --no-recommends --no-suggests --no-conflicts --no-breaks \
        --no-replaces --no-enhances "${minos_meta}" | grep -v '^[ <]'
    dpkg-query -W -f='${db:Status-Abbrev} ${Priority} ${Package}\n' | awk '$1 ~ /^.i/ && $2 == "required" {print $3}'
    _installed dbus sudo openssh-server netplan.io systemd-resolved systemd-timesyncd 'grub*' 'shim*' 'linux-image-*' \
        'linux-modules-*' initramfs-tools kbd console-setup keyboard-configuration locales tzdata ca-certificates \
        dracut dracut-core unattended-upgrades ubuntu-release-upgrader-core
} | sort -u)"
#the four services go whatever the list above says: dbus-user-session is in it on a desktop only as one
#provider of the session bus dconf-service asks for, and the other one, dbus-x11, is the bus minos' X
#session runs. One whose purge would take something that stays is kept, below, and said so
keep="$(printf "%s\n" "${keep}" | grep -vx -e rsyslog -e cron -e networkd-dispatcher -e dbus-user-session)"
#Ubuntu's metapackages may go with what is purged, and an autoremove would then take what they pulled: what
#they pulled, what stays and every package of priority required, important or standard are marked manual
ubuntu="$(_installed ubuntu-minimal ubuntu-server-minimal ubuntu-standard ubuntu-server)" || :
pulled=""
# shellcheck disable=SC2086 # a list of packages
[ -z "${ubuntu}" ] || pulled="$(dpkg-query -W -f='${Depends}, ${Pre-Depends}, ${Recommends}\n' ${ubuntu} |
    tr ',' '\n' | sed 's/[|(].*//; s/:.*//; s/ //g' | grep .)" || :
# shellcheck disable=SC2046,SC2086 # lists of packages
apt-mark manual $( { [ -z "${pulled}" ] || _installed ${pulled}; printf "%s\n" "${keep}"
    dpkg-query -W -f='${db:Status-Abbrev} ${Priority} ${Package}\n' |
        awk '$1 ~ /^.i/ && $2 ~ /^(required|important|standard)$/ {print $3}'; } | sort -u) > /dev/null
_remove() { #what package... => the installed PACKAGES (dpkg patterns) that do not stay purged, with what only
    #they pulled; one whose purge would take something that stays is kept
    what="${1}"; shift
    pkgs="$(_installed "${@}" | grep -vxF "${keep}")" || :
    for pkg in ${pkgs}; do
        if apt-get -s purge "${pkg}" | awk '/^Purg / {print $2}' | grep -qxF "${keep}"; then
            printf "slim: %s: %s kept, minos needs it or what goes with it\n" "${what}" "${pkg}"
            # shellcheck disable=SC2086 # a list of packages
            pkgs="$(printf "%s\n" ${pkgs} | grep -vxF "${pkg}")" || :
        fi
    done
    if [ -n "${pkgs}" ]; then
        # shellcheck disable=SC2086 # a list of packages
        printf "slim: %s purges %s\n" "${what}" "$(apt-get -s purge ${pkgs} | awk '/^Purg / {printf "%s ", $2}')"
        # shellcheck disable=SC2086
        apt-get -y -q purge ${pkgs} > /dev/null
        apt-get -y -q autoremove --purge > /dev/null
    else
        printf "slim: %s: none installed\n" "${what}"
    fi
}
_remove "reports, advertising and Ubuntu Pro" apport apport-symptoms apport-core-dump-handler python3-apport \
    python3-problem-report whoopsie popularity-contest ubuntu-report landscape-common landscape-client \
    motd-news-config ubuntu-pro-client ubuntu-pro-client-l10n ubuntu-advantage-tools update-notifier-common \
    pollinate sosreport
_remove "cloud tools" cloud-guest-utils cloud-initramfs-copymods cloud-initramfs-dyn-netconf \
    ubuntu-cloudimage-keyring grub-legacy-ec2 lxd-installer lxd-agent-loader open-vm-tools open-iscsi
_remove "tools minos replaces or does not use" byobu screen eatmydata ed pastebinit run-one ltrace lshw \
    info install-info usbutils psmisc ufw uidmap hdparm laptop-detect irqbalance os-prober needrestart \
    software-properties-common python3-software-properties packagekit packagekit-tools iso-codes \
    python3-babel python-babel-localedata xdg-user-dirs shared-mime-info publicsuffix mlocate plocate \
    nano w3m ppp powermgmt-base ethtool vlan ifenslave fakeroot libc6-dev linux-libc-dev eject \
    geoip-database krb5-locales 'language-pack-*' fonts-ubuntu-console accountsservice \
    vim-tiny gawk xauth dmidecode bind9-host bind9-dnsutils dnsutils ftp tnftp inetutils-telnet telnet \
    crash kdump-tools makedumpfile bpftool manpages-dev manpages binutils binutils-common \
    'binutils-x86-64-linux-gnu' libbinutils libgprofng0 'libctf*' 'libsframe*' hwctl python3-setuptools
_remove "servers minos never wanted" xinetd sasl2-bin 'sendmail*' sensible-mda rmail bsd-mailx 'apache2*' \
    bind9 rpcbind postfix cifs-utils 'samba*'
_remove "services no minos package asks for" rsyslog cron networkd-dispatcher dbus-user-session
set -x

EOF
} #_live_slim_script: the minos ISO's build reads this function to slim its live system the same way

_live_params() {
    [ -z "${4}" ] && return 1 || shift

    case "${1}" in
        c*|d*)
            case "${1}" in
                c*) submode="core"    ;;
                d*) submode="desktop" ;;
            esac; shift
            ;;
        /*) submode="desktop" ;;
    esac

    root_partition="${1}"
    username="${2}"
    passwd="${3}"
    home_partition="${4}"

    if [ ! -e "${root_partition}" ]; then
        _die "${root_partition} doesn't exists → /"
    fi

    if [ -n "${home_partition}" ]; then
        if [ ! -e "${home_partition}" ]; then
            _die "${home_partition} doesn't exists → /home"
        fi
    fi

    if [ -n "${esp_partition}" ]; then
        if [ ! -e "${esp_partition}" ]; then
            _die "${esp_partition} doesn't exists → /boot/efi"
        fi
    fi
}

################################################################################
# Parse parameters #############################################################
################################################################################

if [ -z "${1}" ]; then
    mode="core"; cx="\b>"
else
    case "${1}" in
        d*|desktop) mode="desktop"; dx="\b>";;
           l*|live) mode="live"
                    case "${2}" in
                        c*|core)    lcx="\b>";;
                        *|desktop)  ldx="\b>";;
                    esac
                    ;;
            *|core) mode="core";    cx="\b>";;
    esac

    while [ "${#}" -gt "0" ]; do #parse options, each one with its parameter
        case "${1}" in
            --release|--esp)
                case "${2}" in
                    ""|-*) _die "Option '${1}' requires a parameter" ;;
                esac
                case "${1}" in
                    --release)
                        RELEASE="$(_get_release_codename "${2}")"
                        if [ -z "${RELEASE}" ]; then
                            _header; _die "Invalid release: ${2}"
                        fi ;;
                    --esp) esp_partition="${2}" ;;
                esac
                shift 2
                ;;
            -*) _header; _die "Invalid option: ${1}" ;;
            #each one quoted, to come back whole: a password may hold spaces, quotes or a *
            *)  args="${args} '$(printf "%s" "${1}" | sed "s/'/'\\\\''/g")'"; shift ;;
        esac
    done
fi

eval "set -- ${args}"
################################################################################
# Main #########################################################################
################################################################################

_header
if _supported; then
    case "${mode}" in
        live) _live_params "${@}" || _die "Missing or incorrect parameters" ;;
    esac
    _is_root || _die "You aren't root!, re-run with admin privileges"

    #give the user chance to cancel before starting
    _printf_sleep "Loading components ..." "3" || exit 1

    trap _cleanup INT QUIT #trap ctrl-c
    #a failed command exits through _die, before the mode puts the sources it set aside back: they go back here,
    #and live mode leaves nothing mounted under its target, also when it stops halfway
    trap '_exit__status="${?}"; _recover_original_reps; [ -z "${_live__tmp_mnt}" ] || _umount_tree "${_live__tmp_mnt}"
          exit "${_exit__status}"' EXIT
    #the _hook function execute $HOME/.minos/hooks/[LETTER][NUMBER] scripts
    #eg: $HOME/.minos/hooks/A01installextral, $HOME/.minos/hooks/Z01finish
    _hooks A
    case "${mode}" in
           core)  _core    ;;
        desktop)  _desktop ;;
           live)  _live    ;;
    esac
    _hooks Z; : #finish script with 0, independly of latest hooks result
else
    printf "%s %s\\n" "FAILED: Non supported distribution system detected," \
            "run this script on ${SUPPORTED} systems only"
fi

# vim: set ts=8 sw=4 tw=0 ft=sh :
